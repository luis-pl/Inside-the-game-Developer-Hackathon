    {
      "css": ".ds-history{display:flex;flex-direction:column;gap:4px;background:var(--side,#101010);padding:15px;width:220px}.ds-conversation{display:flex;align-items:center;justify-content:flex-start;gap:9px;padding:10px 9px;background:transparent;color:var(--text,#ededed);border:0;border-radius:5px;text-align:left;font:400 13px/1.5 \"Segoe UI\",system-ui,sans-serif;cursor:pointer;transition:background .15s,color .15s}.ds-conversation svg{flex:none}.ds-conversation span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-conversation:hover,.ds-conversation.ds-selected{background:var(--hover,#292929)}.ds-conversation:focus-visible{outline:2px solid var(--text,#ededed);outline-offset:3px}",
