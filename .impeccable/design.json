    {
      "css": ".ds-composer{position:relative;margin-top:12px;border:1px solid var(--line,#303030);border-radius:10px;background:var(--input,#242424);padding:11px 10px 40px}.ds-message{display:block;resize:vertical;min-height:58px;max-height:180px;width:100%;background:transparent;color:var(--text,#ededed);border:0;font:400 13px/1.6 \"Segoe UI\",system-ui,sans-serif}.ds-message::placeholder{color:var(--muted,#a4a4a4)}.ds-send{display:inline-flex;align-items:center;justify-content:center;position:absolute;bottom:8px;right:8px;width:29px;height:29px;border:0;border-radius:6px;background:var(--primary,#f0f0f0);color:var(--inverse,#171717);cursor:pointer;transition:background .15s,color .15s}.ds-send:hover:not(:disabled){filter:brightness(.88)}.ds-send:disabled{opacity:.4;cursor:not-allowed}.ds-message:focus-visible{outline:2px solid var(--text,#ededed);outline-offset:3px}.ds-send:focus-visible{outline:2px solid var(--text,#ededed);outline-offset:3px}.ds-send{transition:transform var(--motion-feedback,150ms) var(--ease-ui-out,cubic-bezier(.23,1,.32,1)),background-color var(--motion-feedback,150ms) ease}.ds-send:active:not(:disabled){transform:scale(.96)}@media(prefers-reduced-motion:reduce){.ds-send{transition:none}.ds-send:active:not(:disabled){transform:none}}",
