    {
      "kind": "custom",
      "name": "Document update",
      "description": "Exact change counts and revision, paired with an explicit destination in the document.",
      "html": "<div class=\"ds-update\" role=\"status\"><span class=\"ds-update-arrow\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 4v16m-5-5 5 5 5-5\"/></svg></span><div><strong>1 gráfico actualizado</strong><small>Versión 2 · Cambios listos para revisar</small></div><button class=\"ds-update-action\">Ver cambios <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 4v16m-5-5 5 5 5-5\"/></svg></button></div>",
      "css": ".ds-update{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line,#303030);background:var(--panel,#191919);color:var(--text,#ededed);font:400 13px/1.5 \"Segoe UI\",system-ui,sans-serif}.ds-update-arrow{display:grid;place-items:center;width:28px;height:28px;border:1px solid var(--line,#303030);border-radius:6px;flex:none}.ds-update>div{flex:1;min-width:0}.ds-update strong{font-size:12px;font-weight:550}.ds-update small{display:block;font-size:10px;color:var(--muted,#a4a4a4);margin-top:3px}.ds-update-action{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:0;background:var(--primary,#f0f0f0);color:var(--inverse,#171717);font:400 11px/1.5 \"Segoe UI\",system-ui,sans-serif;border-radius:5px;padding:8px 10px;cursor:pointer;transition:background .15s,color .15s}.ds-update-action:hover:not(:disabled){background:var(--hover,#292929)}.ds-update-action:disabled{opacity:.4;cursor:not-allowed}.ds-update-action:focus-visible{outline:2px solid var(--text,#ededed);outline-offset:3px}@media(max-width:760px){.ds-update{padding:10px;gap:7px;flex-wrap:wrap}.ds-update>div{min-width:160px}.ds-update-action{margin-left:35px}}",
      "refersTo": "document-update"
    },
