  "narrative": {
    "northStar": "The Analysis Desk",
    "donts": [
      "**Don't** introduce a chromatic accent into the monochrome workspace shell.",
      "**Don't** turn flat workspace panes into a collection of raised cards.",
      "**Don't** reuse the mobile drawer shadow on permanent desktop surfaces.",
      "**Don't** promote surface-specific large headings or the existing text-glyph\n  error dismiss control into reusable display or icon primitives."
    ],
    "rules": [
      {
        "section": "colors",
        "name": "The Paired Roles Rule",
        "body": "Change themes by swapping the complete semantic role\nset; keep the same information hierarchy in both themes."
      },
      {
        "section": "colors",
        "name": "The Document Color Rule",
        "body": "Keep the workspace shell monochrome while preserving\nthe report and viewer's established analytical color meanings."
      },
      {
        "section": "elevation",
        "name": "The Flat Workspace Rule",
        "body": "Keep permanent desktop panes flat; reserve the\nimplemented shadow for the temporary mobile drawer."
      }
    ],
    "dos": [
      "**Do** apply the complete theme role set and keep focus visible in both modes.",
      "**Do** preserve independent pane scrolling and keep chat composition reachable.",
      "**Do** show evidence provenance, including synthetic-data labels, near selection.",
      "**Do** use inline outline SVG icons and geometric football illustrations.",
      "**Do** preserve the existing report and topology viewer's analytical colors."
    ],
    "keyCharacteristics": [
      "Pure neutral interface with theme-paired semantic roles.",
      "Compact navigation and controls around a spacious document.",
      "Tonal grouping and fine dividers rather than raised cards.",
      "Geometric football imagery and inline outline SVG icons.",
      "Visible focus, real progress states, and reduced-motion support."
    ],
    "overview": "The conversational workspace is a compact, quiet place to ask about a match,\ninspect the resulting document, and continue refining it. Its visual language\ncomes from the implemented workspace: pure neutrals, tonal surfaces, restrained\ndividers, compact controls, and visible keyboard focus. Black and white themes\ncarry equivalent roles.\n\nThis system applies to `frontend/src/Workspace.tsx` and\n`frontend/src/workspace.css`. The existing topology viewer and generated reports\nretain their separate visual systems, including approved team colors. The\nworkspace's document theme adapter is an integration detail, not a redefinition\nof those systems. Product evidence and source provenance must remain readable."
  }
}
