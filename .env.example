# Configuracion de servidor, nunca parametros de una solicitud HTTP.
INSIDE_GAME_SQL_SERVER=sql-inside-game-01a160e1-ca.database.windows.net
INSIDE_GAME_SQL_DATABASE=inside-game
INSIDE_GAME_SQL_READER=inside_game_api_reader
INSIDE_GAME_LOCAL_ACCESS=true
# Origen de la API al que llama el servidor MCP (sin ruta /api).
INSIDE_GAME_MCP_API_URL=http://127.0.0.1:8000
# Para acceso remoto: LOCAL_ACCESS=false y una clave aleatoria de al menos 32 caracteres.
# INSIDE_GAME_API_KEY=
# El despliegue cloud usa claves individuales: sólo hashes, roles y caducidad.
# INSIDE_GAME_CREDENTIALS_JSON=[]
# INSIDE_GAME_CLOUD=true
# INSIDE_GAME_PUBLIC_HOST=<nombre>.azurecontainerapps.io
# INSIDE_GAME_SQL_AUTH=managed_identity
# AZURE_CLIENT_ID=<client-id-de-identidad-administrada>
# En cloud INSIDE_GAME_SQL_READER queda vacío: se usa el usuario externo propio.
# Si Azure CLI no esta en PATH, completa rutas locales sin incluir tokens:
# AZURE_CLI_PATH=
# AZURE_CONFIG_DIR=

# Dashboard local: origen de la API remota. La clave Bearer permanece en el servidor.
INSIDE_GAME_API_URL=https://api-inside-game.redhill-f7b17d2a.canadacentral.azurecontainerapps.io
# INSIDE_GAME_API_KEY=<clave-individual>

# Agente de datos: destino MCP y modelo, configuración exclusiva del ejecutor.
# INSIDE_GAME_MODEL_PROVIDER=azure  # azure, opencode u opencode-go; sin fallback.
# INSIDE_GAME_DATA_MCP_URL=https://<nombre>.azurecontainerapps.io/mcp
# INSIDE_GAME_DATA_MCP_KEY=    # Clave individual agent-data, inyectar como secreto.
# INSIDE_GAME_DATA_MCP_CREDENTIAL_FILE=  # Alternativa local: archivo individual fuera de Git.
# AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
# INSIDE_GAME_MODEL_AUTH=azure_cli  # managed_identity en Azure; api_key también disponible.
# AZURE_OPENAI_API_KEY=            # Sólo si MODEL_AUTH=api_key; nunca en Git.
# INSIDE_GAME_REASONING_EFFORT=medium
# INSIDE_GAME_MODEL_API=responses  # chat_completions para GPT-OSS en Foundry.
# Se omite temperature al utilizar razonamiento.

# OpenCode Console/Zen: requiere saldo y clave propios; los créditos Azure no aplican.
# La suscripción Go no se importa como credencial Console de manera implícita.
# INSIDE_GAME_MODEL_PROVIDER=opencode
# INSIDE_GAME_OPENCODE_MODEL=gpt-6-luna
# INSIDE_GAME_OPENCODE_API=responses
# INSIDE_GAME_OPENCODE_AUTH_FILE=C:/Users/<usuario>/.local/share/opencode/auth.json
# INSIDE_GAME_OPENCODE_API_KEY=  # Alternativa: inyectar desde un almacén privado.
# Para uso explícito de Go: INSIDE_GAME_MODEL_PROVIDER=opencode-go.
# Sesión autorizada del CLI, sin copiar tokens al repositorio:
# INSIDE_GAME_OPENCODE_AUTH_MODE=cli_session
# INSIDE_GAME_OPENCODE_CLI_DB=C:/Users/<usuario>/.local/share/opencode/opencode.db
# Modelo gratuito confirmado en la cuenta: beam-free, API chat_completions.
# INSIDE_GAME_OPENCODE_FREE_ONLY=1
# Lee únicamente opencode-go del archivo externo y envía una sesión UUID estable.
